FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (cleanup via apt-get and package management)
# tesseract-ocr + tesseract-ocr-spa (paquete de idioma espanol, el corpus es
# 100% en espanol): fallback OCR para paginas de PDF donde pypdf extrae muy
# poco texto (copias de biblioteca con marca de agua/DRM que renderizan el
# contenido real como imagen) -- ver app/rag/extractors.py::extract_pdf_pages.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc tesseract-ocr tesseract-ocr-spa \
    && apt-get clean \
    && apt-get autoclean

# Copy application code and metadata before installing (editable install needs
# the "app" package directory and README.md to already be present, since
# pyproject.toml declares packages=["app", "chainlit_ui"] and readme="README.md")
COPY pyproject.toml README.md pytest.ini docker-compose.yml .env.example ./
COPY app/ ./app/
COPY chainlit_ui/ ./chainlit_ui/
COPY tests/ ./tests/
COPY docs/sample_evidence/ ./docs/sample_evidence/
# .ai/guardrails/ (no todo .ai/): tests/specs/test_spec_009_entorno_docker_reproducible.py
# valida que el guardrail que bloquea borrar los volumenes nombrados siga documentado.
COPY .ai/guardrails/ ./.ai/guardrails/
RUN pip install --no-cache-dir -e . # docker image build

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health').read()" || exit 1

# Run FastAPI server
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
