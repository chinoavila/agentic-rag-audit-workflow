FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (cleanup via apt-get)
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc curl \
    && apt-get clean \
    && apt-get autoclean

# Copy application code and metadata before installing (editable install needs
# the "app" package directory and README.md to already be present, since
# pyproject.toml declares packages=["app", "chainlit_ui"] and readme="README.md").
# The "app" package is required at runtime too: chainlit_ui/app.py imports
# app.agentic_core, app.db, app.deps, app.models, app.routers, app.schemas directly.
COPY pyproject.toml README.md ./
COPY app/ ./app/
COPY chainlit_ui/ ./chainlit_ui/
RUN pip install --no-cache-dir -e . # docker image build

# Create .chainlit config directory
RUN mkdir -p /app/.chainlit

# Expose port (Chainlit default: 8000, but we use 8001 to avoid conflict with backend)
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Run Chainlit UI
# Entrypoint is deliberately NOT named app.py: chainlit's module loader inserts
# chainlit_ui/ at the front of sys.path before exec'ing this file, so a file named
# app.py would shadow the real top-level "app" package the moment this module does
# `from app.agentic_core...` — resolving to itself instead of app/agentic_core/.
CMD ["chainlit", "run", "chainlit_ui/chat.py", "--host", "0.0.0.0", "--port", "8001"]
